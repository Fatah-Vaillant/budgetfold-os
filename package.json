{
  "name": "budgetfold-os",
  "version": "1.0.0",
  "private": true,
  "description": "BudgetFold OS : budget par enveloppes, 100 % local (PWA vanilla JS).",
  "scripts": {
    "start": "npx --yes serve@14.2.4 -l 5173 .",
    "test": "node tests/check.js && node tests/run.js",
    "test:app": "node tests/run.js app",
    "test:ocr": "node tests/run.js ocr",
    "test:fast": "node tests/check.js && node tests/run.js analytics calculs cycle daily data migration mobile projects proofs receipts recurrences security simulation single ui",
    "check": "node tests/check.js",
    "test:refs": "node -e \"process.env.UPDATE_REFS=1;require('./tests/visual.test.js')\"",
    "audit": "node tools/audit.mjs",
    "build:single": "node tools/build-single.js",
    "build:icons": "node tools/build-icons.js"
  },
  "devDependencies": {
    "@tesseract.js-data/fra": "1.0.0",
    "lighthouse": "12.8.2",
    "lucide": "0.460.0",
    "pdfjs-dist": "4.10.38",
    "puppeteer": "24.43.1",
    "puppeteer-core": "24.43.1",
    "qrcode-generator": "1.4.4",
    "tesseract.js": "5.1.1"
  }
}
